# Default: a complete local demo with scripted replies and no cloud credentials.
DEMO_SECONDS=120
DATA_DIR=./data
AGORA_ENABLED=false

# Live voice: use your own Agora project, enable Conversational AI, and set true above.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_AREA=AP
AGORA_VOICE_ID=Arrogant_Miss

# Optional: bring your own OpenAI-compatible LLM. Set all three, or leave all blank.
# The URL must be a full Chat Completions endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=
# Optional MiniMax credential, depending on your Agora project and region.
TTS_API_KEY=

# Optional: seven initial gift names, each {"en":"…","zh":"…"}.
# Change names and quantities in the staff inventory screen after initialization.
GIFTS_JSON=

# Optional online deployment: use an independent remote libSQL database.
# DEPLOYMENT=online
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Online deployments require different staff/guest codes and a 32+ character secret.
SESSION_SECRET=
ADMIN_PASSCODE=
DISPLAY_PASSCODE=
